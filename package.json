{
	"name": "wikiparser-node",
	"version": "2.1.0",
	"description": "A Node.js parser for MediaWiki markup with AST",
	"keywords": [
		"mediawiki",
		"wikitext",
		"parser",
		"browser"
	],
	"homepage": "https://github.com/bhsd-harry/wikiparser-node#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/wikiparser-node/issues"
	},
	"license": "GPL-3.0-or-later",
	"author": "Bhsd",
	"files": [
		"/bundle/bundle*.js",
		"/extensions/dist/*.js",
		"/extensions/*.css",
		"!/extensions/dist/*-page*.js",
		"!/extensions/*-page.css",
		"/printed/README",
		"/errors/README",
		"/config/",
		"!/config/mediawikiwiki.json",
		"!/config/github.json",
		"/data/",
		"/i18n/",
		"/coverage/badge.svg",
		"/bin/*.js",
		"/dist/",
		"!/dist/script/",
		"!/dist/test/"
	],
	"bin": {
		"getParserConfig": "bin/config.js"
	},
	"browser": "/bundle/bundle-lsp.min.js",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/wikiparser-node.git"
	},
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only -a --omit=dev",
		"prepublishOnly": "npm run build:core",
		"bundle": "esbuild index.ts --charset=utf8 --bundle --target=es2024 --format=cjs --external:entities --outfile=build/bundle-html.js",
		"build:core": "npm run bundle && esbuild index.ts --charset=utf8 --bundle --minify --target=es2019 --format=esm --drop-labels=NPM --sourcemap --outfile=bundle/bundle-html.min.js && eslint --no-config-lookup -c eslint.browser.mjs bundle/bundle-html.min.js",
		"build:test": "bash build.sh",
		"build": "npm run build:core && npm run build:test",
		"diff": "bash diff.sh",
		"diff:stat": "f() { git diff --stat -w --color=always $1 $2 -- . | grep '\\.ts'; }; f",
		"lint:ts": "[ ! -f dist/bin/config.js ] && npm run build:core; tsc --noEmit && eslint --cache .",
		"lint:bundle": "eslint --no-config-lookup --no-inline-config --parser=@typescript-eslint/parser --rule 'no-unused-vars: [2, {args: none}]' build/*.js",
		"lint": "npm run lint:ts",
		"prof": "node dist/test/prof.js",
		"coverage": "tsc -d false -t es2024 && c8 npm test && node dist/script/coverage.js && open coverage/index.html",
		"test:parser": "LC_ALL=en.UTF-8 testUtil dist/test/parserTests.js",
		"test:perf": "testUtil --test-reporter=spec dist/test/perf.js",
		"test": "npm run test:parser",
		"test:end": "pkill -x http-server",
		"test:real": "node dist/test/real.js"
	},
	"c8": {
		"exclude": [
			"dist/script/*.js",
			"dist/test/*.js"
		],
		"reporter": [
			"html",
			"text-summary",
			"json-summary"
		]
	},
	"dependencies": {
		"@bhsd/cm-util": "^2.4.2",
		"@bhsd/common": "^4.1.0",
		"@bhsd/nodejs": "^1.2.1",
		"entities": "^9.0.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^5.1.0",
		"@bhsd/test-util": "^3.3.0",
		"@eslint/markdown": "^8.0.3",
		"@types/jsdom": "^30.0.0",
		"c8": "^12.0.0",
		"diff2html-cli": "^5.2.15",
		"dompurify": "^3.4.17",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"jsdom": "^30.1.3",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": "^22.13.0 || >=24.11.0"
	}
}
