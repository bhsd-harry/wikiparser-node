{
	"name": "wikiparser-html",
	"version": "2.2.0",
	"description": "A browser parser that renders MediaWiki markup to HTML",
	"keywords": [
		"mediawiki",
		"wikitext",
		"parser",
		"html",
		"browser"
	],
	"homepage": "https://github.com/bhsd-harry/wikiparser-node/tree/html#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/wikiparser-node/issues"
	},
	"license": "GPL-3.0-or-later",
	"author": "Bhsd",
	"files": [
		"/bundle/bundle-html.min.js",
		"/config/",
		"!/config/mediawikiwiki.json",
		"!/config/github.json",
		"/i18n/",
		"/coverage/badge.svg",
		"/dist/**/*.d.ts"
	],
	"main": "./bundle/bundle-html.min.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/wikiparser-node.git"
	},
	"scripts": {
		"prepublishOnly": "npm run build:core && gsed -i '/\\/\\/# sourceMappingURL=/d' bundle/bundle-html.min.js",
		"bundle": "esbuild index.ts --charset=utf8 --bundle --target=es2024 --format=cjs --external:entities --external:parse5 --outfile=build/bundle-html.js",
		"build:core": "npm run bundle && esbuild index.ts --charset=utf8 --bundle --minify --target=es2019 --format=esm --drop-labels=NPM --sourcemap --outfile=bundle/bundle-html.min.js && npm run size && eslint --no-config-lookup -c eslint.browser.mjs bundle/bundle-html.min.js",
		"build:test": "bash build.sh",
		"build": "npm run build:core && npm run build:test",
		"diff": "bash diff.sh",
		"diff:stat": "f() { git diff --stat -w --color=always $1 $2 -- . | grep '\\.ts'; }; f",
		"lint:ts": "tsc --noEmit && eslint --cache .",
		"lint": "npm run lint:ts",
		"prof": "node dist/test/prof.js",
		"coverage": "c8 npm test && node dist/script/coverage.js && open coverage/index.html",
		"test:parser": "LC_ALL=en.UTF-8 testUtil dist/test/parserTests.js",
		"test:perf": "testUtil --test-reporter=spec dist/test/perf.js",
		"test": "npm run test:parser",
		"test:end": "pkill -x http-server",
		"test:real": "node dist/test/real.js",
		"size": "echo \"\n$(( $(gzip -c bundle/bundle-html.min.js | wc -c) / 1024 )) kB\""
	},
	"c8": {
		"exclude": [
			"dist/script/*.js",
			"dist/test/*.js"
		],
		"reporter": [
			"html",
			"text-summary",
			"json-summary"
		]
	},
	"devDependencies": {
		"@bhsd/cm-util": "^2.4.3",
		"@bhsd/code-standard": "^5.2.0",
		"@bhsd/common": "^4.2.0",
		"@bhsd/nodejs": "^1.3.0",
		"@bhsd/test-util": "^3.3.1",
		"c8": "^12.0.0",
		"diff2html-cli": "^5.2.15",
		"entities": "^9.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"parse5": "^8.1.1",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": "^22.13.0 || >=24.11.0"
	}
}
